{
  "$schema": "https://github.com/garrytan/gstack/docs/pregate.md#pregate-v1",
  "runner": "pytest {files}",
  "dependencies": {
    ".claude-plugin/*.json": [
      "tests/test_integration_hardening.py",
      "tests/test_docs_install.py",
      "tests/test_mcp_server.py",
      "tests/test_public_claims.py"
    ],
    "plugin.json": [
      "tests/test_integration_hardening.py",
      "tests/test_docs_install.py",
      "tests/test_mcp_server.py"
    ],
    ".mcp.json": [
      "tests/test_mcp_server.py",
      "tests/test_public_claims.py"
    ],
    "pyproject.toml": [
      "tests/test_integration_hardening.py",
      "tests/test_public_claims.py"
    ],
    "scripts/check_plugin_mcp.py": [
      "tests/test_check_plugin_mcp.py",
      "tests/test_repo_workflows.py"
    ],
    "scripts/fetch_claude_compliance.py": [
      "tests/test_integration_hardening.py",
      "tests/test_claude_ecosystem.py"
    ],
    ".github/workflows/**": [
      "tests/test_repo_workflows.py"
    ],
    ".github/ISSUE_TEMPLATE/**": [
      "tests/test_issue_forms.py"
    ],
    "scanner/suppressions.py": [
      "tests/test_suppressions.py",
      "tests/test_founder_triage.py"
    ],
    "scanner/settings.py": [
      "tests/test_settings.py",
      "tests/test_suppressions.py"
    ],
    "hooks/**": [
      "tests/test_secret_guard_hook.py",
      "tests/test_integration_hardening.py",
      "tests/test_founder_triage.py"
    ],
    "commands/*.md": [
      "tests/test_integration_hardening.py",
      "tests/test_claude_ecosystem.py",
      "tests/test_docs_install.py",
      "tests/test_issue_forms.py"
    ],
    "skills/**/*.md": [
      "tests/test_integration_hardening.py",
      "tests/test_claude_ecosystem.py",
      "tests/test_docs_install.py"
    ],
    "*.md": [
      "tests/test_docs_install.py"
    ],
    "**/*.md": [
      "tests/test_docs_install.py"
    ]
  }
}
